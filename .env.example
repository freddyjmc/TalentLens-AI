# Copia este archivo como .env y rellena tus valores. No subas nunca el .env a GitHub.

# Clave de la API de OpenAI
OPENAI_API_KEY=tu_clave_aqui
# Opcional: modelo de OpenAI (por defecto gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Adzuna (búsqueda de ofertas). Credenciales gratuitas en https://developer.adzuna.com/
ADZUNA_APP_ID=tu_app_id
ADZUNA_APP_KEY=tu_app_key

# MongoDB (con el docker-compose incluido, en local)
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB_NAME=asistente
